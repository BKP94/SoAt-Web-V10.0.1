@inject IConfiguration Config

<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* ฟอนต์ Prompt (self-host — ใช้ได้บน intranet ไม่พึ่ง Google CDN) *@
    <link rel="stylesheet" href="@Assets["fonts/prompt.css"]" />
    <!-- Bootstrap Icons (self-host, subset) — icon ใหม่ต้องรัน tools/bootstrap-icons/subset.py -->
    <link rel="stylesheet" href="@Assets["icons/bootstrap-icons.min.css"]" />
    @* DevExpress theme — เปลี่ยน theme ที่ appsettings "DevExpress:Theme" จุดเดียว *@
    @if (string.Equals(Config["DevExpress:Theme"], "fluent", StringComparison.OrdinalIgnoreCase))
    {
        @DxResourceManager.RegisterTheme(Themes.Fluent)
    }
    else
    {
        <link rel="stylesheet" href="_content/DevExpress.Blazor.Themes/@(Config["DevExpress:Theme"] ?? "office-white").bs5.min.css" />
    }
    <ResourcePreloader />
    @* favicon = โลโก้ SO-AT (emblem) จุดเดียวจาก RCL SoAt.Blazor *@
    <link rel="icon" type="image/png" href="@Assets["_content/SoAt.Blazor/favicon.png"]" />
    @* มาตรฐานปุ่ม action กลาง (soat-btn) — จุดเดียวจาก RCL SoAt.Blazor *@
    <link rel="stylesheet" href="@Assets["_content/SoAt.Blazor/soat.css"]" />
    @* design tokens ของ scCenter (สี/ฟอนต์/ระยะ) — โหลดก่อน app.css *@
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["scCenter.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/portal.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

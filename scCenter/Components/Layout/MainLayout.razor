@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-topbar">
        <a class="app-brand" href="/" aria-label="กลับหน้าศูนย์รวมระบบงาน"><img src="ImgMenu/Logo_SoAt.png" alt="SO-AT Solution" width="66" height="32" /></a>

        <div class="app-topbar-spacer"></div>

        <AuthorizeView>
            <Authorized>
                <span class="app-user">@context.User.Identity?.Name</span>
                <form method="post" action="/logout" class="app-logout-form">
                    <AntiforgeryToken />
                    <DxButton CssClass="app-logout"
                              Text="ออกจากระบบ"
                              IconCssClass="bi bi-box-arrow-right"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              SubmitFormOnClick="true" />
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="app-login-link" href="/?login=1">เข้าสู่ระบบ</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    เกิดข้อผิดพลาดที่ไม่คาดคิด
    <a href="." class="reload">โหลดหน้าใหม่</a>
    <button type="button" class="dismiss" aria-label="ปิดข้อความ"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
</div>

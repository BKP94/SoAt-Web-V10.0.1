@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>ระบบขัดข้อง</PageTitle>

@* หน้าที่ UseExceptionHandler re-execute มา (production เท่านั้น) — ห้ามโชว์รายละเอียด exception/ค่า environment ให้ผู้ใช้ *@
<section class="app-empty">
    <h1>ระบบทำรายการนี้ไม่สำเร็จ</h1>
    <p>เกิดข้อผิดพลาดระหว่างประมวลผล ลองใหม่อีกครั้ง ถ้ายังไม่ได้ ให้แจ้งฝ่ายไอทีของสหกรณ์พร้อมรหัสอ้างอิงด้านล่าง</p>

    <dl class="app-ref">
        @if (ShowRequestId)
        {
            <div><dt>รหัสอ้างอิง</dt><dd><code>@RequestId</code></dd></div>
        }
        <div><dt>โทรศัพท์</dt><dd><a href="tel:+6620590511">02 059 0511</a></dd></div>
    </dl>

    <div class="app-actions">
        <a class="app-home-link" href="@RetryUrl">ลองอีกครั้ง</a>
        <a class="app-home-link" href="/">กลับหน้าศูนย์รวมระบบงาน</a>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private string RetryUrl { get; set; } = "/";

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        // ลองซ้ำได้เฉพาะ GET — POST (เช่น login) ส่งกลับหน้าหลักแทน กันยิงฟอร์มซ้ำ
        // path ต้องเป็น local ("/x" ไม่ใช่ "//host" หรือ "/\host") กัน open redirect
        var failed = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        var path = failed?.Path;
        if (path is { Length: > 0 } && path[0] == '/' && (path.Length == 1 || (path[1] != '/' && path[1] != '\\'))
            && HttpMethods.IsGet(HttpContext!.Request.Method))
            RetryUrl = path + HttpContext.Request.QueryString.Value;
    }
}

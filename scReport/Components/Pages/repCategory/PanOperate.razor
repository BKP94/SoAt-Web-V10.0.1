@* PanOperate (repCategory) — แถบคำสั่ง (Command Stack แนวตั้ง ขวาของหน้า)
   เลียน legacy panOperate.ascx: btSave "บันทึก" + btMove "ย้ายกลุ่ม"
   (btExport/btImport = เลื่อนไปเฟส 2)
   ปุ่ม raise EventCallback กลับให้ Page จัดการ
   สไตล์ .op-stack/.op-cmd อยู่ที่ soat.css — ปุ่มหลัก = บันทึก *@

<div class="op-stack" role="toolbar" aria-orientation="vertical" aria-label="คำสั่งกลุ่มรายงาน">
    <DxButton RenderStyle="ButtonRenderStyle.Primary"
              Text="บันทึก" title="บันทึก"
              @onclick="OnSave" CssClass="op-cmd op-cmd--primary"
              IconCssClass="@sc.icon.Floppy" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="ย้ายกลุ่ม" title="ย้ายข้อรายงานไปกลุ่มอื่น"
              disabled="@(!CanMove)" @onclick="OnMove" CssClass="op-cmd"
              IconCssClass="@sc.icon.ArrowLeftRight" />
</div>

@code {
    /// ย้ายได้เมื่อเลือกข้อรายงานแล้ว
    [Parameter] public bool CanMove { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnMove { get; set; }
}

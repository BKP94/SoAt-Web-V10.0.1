@* PanOperate (repProgram) — แถบคำสั่ง (Command Stack แนวตั้ง ขวาของหน้า)
   เลียน legacy panOperate ของ repProgram: ปุ่มบันทึก (ofSave)
   ปุ่ม raise EventCallback กลับให้ Page จัดการ (Page ถือ model + guard C30)
   สไตล์ .op-stack/.op-cmd อยู่ที่ soat.css — ปุ่มหลัก = บันทึก *@

<div class="op-stack" role="toolbar" aria-orientation="vertical" aria-label="คำสั่งไฟล์รายงาน">
    <DxButton RenderStyle="ButtonRenderStyle.Primary"
              Text="บันทึก" title="บันทึกไฟล์รายงาน"
              @onclick="OnSave" CssClass="op-cmd op-cmd--primary"
              IconCssClass="@sc.icon.Floppy" />
</div>

@code {
    [Parameter] public EventCallback OnSave { get; set; }
}

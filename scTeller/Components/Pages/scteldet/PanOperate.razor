@* ── PanOperate (scteldet) — แถบคำสั่ง (Command Stack แนวตั้งขวา) ──────────────────────
   viewer (read-only) → ไม่มี Save/Cancel. ปุ่ม raise EventCallback กลับให้ Page
   เลียน legacy panOperate.ascx: New / ScanID / Signature / Memo / PrintTab
   Signature/Memo/PrintTab/ScanID = stub รอบนี้ (ผูกระบบจริงภายหลัง)
   สไตล์ .op-stack/.op-cmd อยู่ที่ soat.css — ไม่มีบันทึก → ปุ่มหลัก = เพิ่มใหม่ *@

<div class="op-stack" role="toolbar" aria-orientation="vertical" aria-label="คำสั่งสมาชิก">
    <DxButton RenderStyle="ButtonRenderStyle.Primary"
              Text="เพิ่มใหม่" title="เพิ่มใหม่ / ล้างหน้า"
              disabled="@Busy" @onclick="OnNew" CssClass="op-cmd op-cmd--primary"
              IconCssClass="@sc.icon.FileEarmarkPlus" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="อ่านบัตร" title="อ่านบัตรประชาชน"
              disabled="@Busy" @onclick="OnScanCard" CssClass="op-cmd"
              IconCssClass="@sc.icon.CreditCard2Front" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="ลายเซ็น" title="แสดงลายเซ็น"
              disabled="@Busy" @onclick="OnSignature" CssClass="op-cmd"
              IconCssClass="@sc.icon.VectorPen" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="Memo" title="บันทึกข้อความ (Memo)"
              disabled="@Busy" @onclick="OnMemo" CssClass="op-cmd"
              IconCssClass="@sc.icon.JournalText" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="พิมพ์" title="พิมพ์แท็บปัจจุบัน"
              disabled="@Busy" @onclick="OnPrintTab" CssClass="op-cmd"
              IconCssClass="@sc.icon.Printer" />
</div>

@code {
    /// ปิดปุ่มทั้งหมดระหว่างกำลังโหลด
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnScanCard { get; set; }
    [Parameter] public EventCallback OnSignature { get; set; }
    [Parameter] public EventCallback OnMemo { get; set; }
    [Parameter] public EventCallback OnPrintTab { get; set; }
}

@* PanOperate — แถบคำสั่ง (Command Stack แนวตั้ง, ขวาของหน้า) — New / Open / Save / Cancel
   ปุ่ม raise EventCallback กลับให้ Page จัดการ logic (Page ถือ model)
   สไตล์ .op-stack/.op-cmd อยู่ที่ soat.css (RCL กลาง) — ปุ่มหลัก = บันทึก *@

<div class="op-stack" role="toolbar" aria-orientation="vertical" aria-label="คำสั่งสมัครสมาชิก">
    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="เพิ่มใหม่" title="เพิ่มใหม่"
              disabled="@Busy" @onclick="OnNew" CssClass="op-cmd"
              IconCssClass="@sc.icon.FileEarmarkPlus" />

    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="เปิด" title="เปิด / ค้นหา"
              disabled="@Busy" @onclick="OnOpen" CssClass="op-cmd"
              IconCssClass="@sc.icon.Folder2Open" />

    <DxButton RenderStyle="ButtonRenderStyle.Primary"
              Text="บันทึก" title="บันทึก"
              disabled="@Busy" @onclick="OnSave" CssClass="op-cmd op-cmd--primary"
              IconCssClass="@sc.icon.Floppy" />

    <DxButton RenderStyle="ButtonRenderStyle.Danger"
              RenderStyleMode="ButtonRenderStyleMode.Outline"
              Text="ยกเลิก" title="ยกเลิก"
              disabled="@Busy" @onclick="OnCancel" CssClass="op-cmd op-cmd--danger"
              IconCssClass="@sc.icon.XLg" />
</div>

@code {
    /// ปิดปุ่มทั้งหมดระหว่างกำลังบันทึก
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnNew    { get; set; }
    [Parameter] public EventCallback OnOpen   { get; set; }
    [Parameter] public EventCallback OnSave   { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
